# Model: "ollama" = local open-source model, no key (default). "anthropic" = Claude API.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_NUMBER=
CAREGIVER_PHONE=
SENIOR_PHONE=
SENIOR_NAME=
SENIOR_LANGUAGE=en
PUBLIC_URL=

# Caregiver alerts: "sms" (Twilio text, production) or "ntfy" (free push, no account; used by voice_mode.py)
NOTIFY_CHANNEL=ntfy
# ntfy topics are public by name: pick a long random one, then subscribe to it in the ntfy app or at ntfy.sh/<topic>
NTFY_TOPIC=

# Vapi phone calls (vapi.ai). INBOUND works with a free Vapi number: the senior calls it (see README).
# (Outbound from a free Vapi number hit a daily limit for us; importing a Twilio number into Vapi lifts it.)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Any long random string; Vapi sends it back in X-Vapi-Secret and /vapi/end refuses requests without it.
# python -c "import secrets; print(secrets.token_urlsafe(24))"
VAPI_SECRET=
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o-mini
