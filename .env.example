# Model: "ollama" = local open-source model, no key (default). "anthropic" = Claude API.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_NUMBER=
CAREGIVER_PHONE=
SENIOR_PHONE=
SENIOR_NAME=
SENIOR_LANGUAGE=en
PUBLIC_URL=

# Caregiver alerts: "sms" (Twilio text, production) or "ntfy" (free push, no account; used by voice_mode.py)
NOTIFY_CHANNEL=ntfy
# ntfy topics are public by name: pick a long random one, then subscribe to it in the ntfy app or at ntfy.sh/<topic>
NTFY_TOPIC=

# Vapi phone calls (vapi.ai). Outbound calls need a phone number imported into Vapi (Twilio/Telnyx/DIDWW);
# free Vapi numbers are inbound-only. VAPI_PHONE_NUMBER_ID is that number's id in the Vapi dashboard.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Any long random string; Vapi sends it back on /vapi/end. python -c "import secrets; print(secrets.token_urlsafe(24))"
VAPI_WEBHOOK_SECRET=
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o-mini
